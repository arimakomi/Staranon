# ==============================================================================
# تنظیمات ربات تلگرام صندوق پیام ناشناس چندگانه (AnonBot)
# دسترسی این فایل در محیط عملیاتی باید 600 باشد (chmod 600 /etc/anonbot/.env)
# ==============================================================================

# ۱. تنظیمات اصلی ربات تلگرام
BOT_TOKEN=1234567890:AAH_ReplaceWithYourActualBotTokenFromBotFather
BOT_USERNAME=YourAnonInboxBot
SUPER_ADMINS=123456789

# ۲. کلیدهای امنیتی و رمزنگاری (هرگز پس از راه‌اندازی تغییر ندهید!)
# HMAC_SECRET: رشته تصادفی حداقل ۶۴ کاراکتری برای تولید هش فرستنده در هر صندوق
HMAC_SECRET=replace_with_64_char_random_hex_secret_generated_by_installer
# FERNET_KEY: کلید ۳۲ بایتی Base64 استاندارد Fernet برای رمزنگاری آیدی فرستنده در جدول پیام‌ها
FERNET_KEY=replace_with_valid_fernet_base64_key_generated_by_installer=

# ۳. تنظیمات دیتابیس (SQLite پیش‌فرض یا MySQL)
# مثال SQLite: sqlite+aiosqlite:////var/lib/anonbot/anonbot.db
# مثال MySQL:  mysql+aiomysql://anonbot:password@127.0.0.1:3306/anonbot?charset=utf8mb4
DATABASE_URL=sqlite+aiosqlite:///./anonbot.db

# ۴. تنظیمات Redis اختیاری (برای FSM و Rate Limit؛ اگر خالی باشد از حافظه/دیتابیس استفاده می‌شود)
# مثال: redis://127.0.0.1:6379/0
REDIS_URL=

# ۵. حالت اجرای ربات (polling یا webhook)
RUN_MODE=polling
WEBHOOK_HOST=https://bot.example.com
WEBHOOK_PATH=/webhook/anonbot
WEBHOOK_SECRET=replace_with_webhook_secret_token
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8080

# ۶. تنظیمات پروکسی و سرور Bot API سفارشی
PROXY_ENABLED=false
# فرمت مجاز: socks5://user:pass@host:port یا http://user:pass@host:port
PROXY_URL=
# آدرس سرور Bot API سفارشی (اختیاری؛ پیش‌فرض سرور رسمی تلگرام است)
API_BASE_URL=

# ۷. محدودیت‌ها و سیاست‌های امنیتی پیش‌فرض
RATE_LIMIT_PER_MINUTE=15
DELETE_WINDOW_SECONDS=300
REVEAL_DAILY_LIMIT=5
REVEAL_COOLDOWN_SECONDS=3600
AUTO_BAN_REPORTS_THRESHOLD=3
AUTO_BAN_DURATION_HOURS=72
REACTION_EMOJIS=❤️,👍,😂,🔥,😢
FILTER_LINKS_DEFAULT=false
MAINTENANCE_MODE=false

# ۸. تنظیمات لاگ و مسیرها
LOG_LEVEL=INFO
LOG_DIR=/var/log/anonbot
BACKUP_DIR=/var/backups/anonbot
