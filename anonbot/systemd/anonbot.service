[Unit]
Description=AnonBot - Multi-Inbox Anonymous Telegram Bot Service
After=network-online.target mysql.service redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=anonbot
Group=anonbot
WorkingDirectory=/opt/anonbot
Environment="ANONBOT_ENV_FILE=/etc/anonbot/.env"
Environment="PYTHONUNBUFFERED=1"
EnvironmentFile=/etc/anonbot/.env
ExecStart=/opt/anonbot/venv/bin/python -m app.bot
Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGINT
StandardOutput=journal
StandardError=journal
SyslogIdentifier=anonbot

# Security Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/anonbot /var/log/anonbot /var/backups/anonbot /etc/anonbot

[Install]
WantedBy=multi-user.target
